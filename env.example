# =============================================================================
# Discord Bot Configuration
# Copy this file to .env and fill in your own values.
# =============================================================================

# Bot token (Developer Portal -> Your App -> Bot -> Reset Token). Keep secret!
DISCORD_TOKEN=your_discord_bot_token_here

# Application ID (Developer Portal -> Your App -> General Information)
CLIENT_ID=your_application_client_id

# Server ID (enable Developer Mode in Discord, right-click server -> Copy Server ID)
GUILD_ID=your_server_id

# Channel where update notifications are posted (right-click channel -> Copy Channel ID)
NOTIFY_CHANNEL_ID=your_notification_channel_id

# Role that will be pinged when there is an update (Server Settings -> Roles -> Copy Role ID)
ROLE_ID=your_role_id

# =============================================================================
# Database Configuration
# =============================================================================

# Path to the SQLite database file (directory must exist or be creatable)
DB_PATH=./data/bot.db

# =============================================================================
# API Configuration
# =============================================================================

# Port the HTTP API listens on
API_PORT=3000

# Set to true to enable the HTTP API
API_ENABLED=false

# Secret used to authenticate API requests. Generate one with:
#   openssl rand -hex 32
API_TOKEN=your_secure_api_token_here

# Allowed CORS origin. Use a specific origin in production
# (e.g. https://example.com) instead of * (allow all).
CORS_ORIGIN=*

# =============================================================================
# Security
# =============================================================================

# Rate limit window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW=60000

# Max requests allowed per client within the window
RATE_LIMIT_MAX_REQUESTS=10

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=info

# =============================================================================
# Scheduler
# =============================================================================

# How often (in seconds) the bot checks for updates
CHECK_INTERVAL_SECONDS=60

